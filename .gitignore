# Deny by default: only reviewed project files can be added normally.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.github/workflows/
!/README.md
!/config/
/config/*
!/config/packaging.json
!/docs/
/docs/*
!/docs/manifest.md
!/docs/shop-update.md
!/docs/release-2.4.3.md
!/scripts/
/scripts/*
!/scripts/Common.ps1
!/scripts/Build-Packages.ps1
!/scripts/Test-Packages.ps1
!/scripts/Test-Packaging.ps1
!/tools/
!/tools/repack-shop-packages.py

# Local builds, inventories, notes, prompts and credentials stay unversioned.
/artifacts/
/packages/
/client/
/.local/
**/install-manifest.json
**/SHA256SUMS
*.local.json
*.zip
*.7z
*.rar
*.part
*.log
*.tmp
.env
.env.*
*.pem
*.key
*.pfx
*.p12
__pycache__/

# Reviewed camera patch payload
!/patches/
!/patches/camera/
!/patches/camera/bin64/
!/patches/camera/bin64/version.dll
!/patches/camera/README.md
